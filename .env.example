# ---------------------------------------------------------------------------
# Wortweg environment variables. Copy to `.env` for local development.
# The defaults below work for local development with the Neon Auth stand-in (`npm run auth:dev`).
# NEVER commit a real `.env`. Production values live in Vercel → Settings → Environment Variables.
# Nothing here is exposed to the browser (no NEXT_PUBLIC_* variables).
# See README.md → "Configuration" and "Deploying (Vercel + Neon)".
# ---------------------------------------------------------------------------

# --- Database (required) — SECRET in production -----------------------------
# Development: local Postgres.
# Production (Neon): DATABASE_URL = pooled URL (host contains "-pooler"), DIRECT_URL = direct URL.
#   Both with ?sslmode=require. DIRECT_URL is used by `prisma migrate deploy`.
DATABASE_URL="postgresql://vocab:vocab@localhost:5432/vocab"
DIRECT_URL="postgresql://vocab:vocab@localhost:5432/vocab"

# --- Neon Auth (required) ---------------------------------------------------
# Defined by Neon Auth. Production: the branch's Auth URL from Neon Console → Auth → Configuration.
NEON_AUTH_BASE_URL="http://localhost:4100/neondb/auth"
# Defined by Neon Auth. SECRET in production: `openssl rand -base64 32` (≥32 chars), one per environment.
NEON_AUTH_COOKIE_SECRET="dev-only-cookie-secret-0123456789abcdef"

# App-defined. Neon Auth service account holding the Neon Auth "admin" role, used only server-side
# to create accounts, set passwords and ban/unban. Password is SECRET in production.
AUTH_PROVISIONER_EMAIL="provisioner@wortweg.test"
AUTH_PROVISIONER_PASSWORD="dev-provisioner-password"

# App-defined. Public origin of this app; must be a Neon Auth trusted domain.
# Production: e.g. https://wortweg.example.org (falls back to https://$VERCEL_PROJECT_PRODUCTION_URL).
APP_ORIGIN="http://localhost:3100"

# --- Seeding (used only by `npm run db:seed`; never store in Vercel) ----------
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_EMAIL="admin@wortweg.test"
# SECRET. One-time initial password; change it under "My account" after the first sign-in.
SEED_ADMIN_PASSWORD="change-me-please"
# Development only: creates a "demo" student with chapter 1 of A1 unlocked.
# The seed refuses to run if this is set with NODE_ENV or VERCEL_ENV = production.
SEED_DEMO_STUDENT_PASSWORD=""
SEED_DEMO_STUDENT_EMAIL="demo.student@example.com"

# --- Recording storage ------------------------------------------------------
# "local" (development: files under LOCAL_UPLOAD_DIR, never publicly served)
# "vercel-blob" (production: requires a PRIVATE Vercel Blob store connected to the project)
STORAGE_PROVIDER="local"
LOCAL_UPLOAD_DIR=".data/uploads"
# SECRET. Injected automatically when a Blob store is connected in Vercel; set manually only for local testing.
BLOB_READ_WRITE_TOKEN=""

# --- Pronunciation ----------------------------------------------------------
# "browser-transcript" (default: browser speech recognition, no scoring) or "none" (store recordings only)
PRONUNCIATION_ENGINE="browser-transcript"

# --- Development / CI only --------------------------------------------------
# PW_CHROMIUM_PATH=/path/to/chrome        # use a preinstalled Chromium for Playwright
# NEON_AUTH_EMULATOR_READY_PORT=4109      # readiness port of the e2e Neon Auth stand-in
