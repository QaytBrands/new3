# ---------------------------------------------------------------------------
# Wortweg environment variables. Copy to `.env` for local development.
# NEVER commit a real `.env`. Production values live in Vercel → Settings → Environment Variables.
# See README.md → "Configuration" for which variables are secrets and which are required where.
# ---------------------------------------------------------------------------

# --- Database (required everywhere) -----------------------------------------
# Development: local Postgres. Production (Neon): DATABASE_URL = pooled URL, DIRECT_URL = direct URL.
DATABASE_URL="postgresql://vocab:vocab@localhost:5432/vocab"
DIRECT_URL="postgresql://vocab:vocab@localhost:5432/vocab"

# --- Auth (required everywhere) — SECRET in production -----------------------
# Generate with: openssl rand -base64 32   (use a different value per environment)
AUTH_SECRET="dev-only-change-me"
# Only needed when self-hosting or running `next start` locally; Vercel sets this automatically.
AUTH_TRUST_HOST=true

# --- Seeding (used only by `npm run db:seed`) ---------------------------------
SEED_ADMIN_USERNAME="admin"
# SECRET. Set only in the shell that runs the seed; don't store it in Vercel.
SEED_ADMIN_PASSWORD="change-me-please"
# Development only: creates a "demo" student with chapter 1 of A1 unlocked. Leave empty in production.
SEED_DEMO_STUDENT_PASSWORD=""

# --- Recording storage ------------------------------------------------------
# "local" (development: files under LOCAL_UPLOAD_DIR, never publicly served)
# "vercel-blob" (production: requires a PRIVATE Vercel Blob store connected to the project)
STORAGE_PROVIDER="local"
LOCAL_UPLOAD_DIR=".data/uploads"
# SECRET. Injected automatically when a Blob store is connected in Vercel; set manually only for local testing.
BLOB_READ_WRITE_TOKEN=""

# --- Pronunciation ----------------------------------------------------------
# "browser-transcript" (default: browser speech recognition, no scoring) or "none" (store recordings only)
PRONUNCIATION_ENGINE="browser-transcript"

# --- End-to-end tests (development only) ------------------------------------
# PW_CHROMIUM_PATH=/path/to/chrome   # use a preinstalled Chromium instead of downloading one
