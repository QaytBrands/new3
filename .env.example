# Postgres (Neon in production: use the pooled URL for DATABASE_URL, direct URL for DIRECT_URL)
DATABASE_URL="postgresql://vocab:vocab@localhost:5432/vocab"
DIRECT_URL="postgresql://vocab:vocab@localhost:5432/vocab"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="change-me"
# Needed when self-hosting behind a proxy / running `next start` locally (automatic on Vercel)
AUTH_TRUST_HOST=true

# Initial admin account created by `npm run db:seed`
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="change-me-please"

# Storage for pronunciation recordings: "vercel-blob" (production) or "local" (dev, writes to public/uploads)
STORAGE_PROVIDER="local"
BLOB_READ_WRITE_TOKEN=""

# Pronunciation engine: "browser-transcript" (default) or "none"
PRONUNCIATION_ENGINE="browser-transcript"
# Optional: creates a "demo" student with chapter 1 of A1 unlocked
SEED_DEMO_STUDENT_PASSWORD=""
